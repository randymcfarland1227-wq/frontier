{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "frontier-work-room",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "binding": "ASSETS", "run_worker_first": true },
  // Secrets (never commit values — set with wrangler secret put):
  //   TICKTICK_ACCESS_TOKEN — bearer for POST /api/ticktick/complete → TickTick Open API
  // Commands (from /workspace/frontier after wrangler login):
  //   npx wrangler secret put TICKTICK_ACCESS_TOKEN
  //   npx wrangler deploy
}
